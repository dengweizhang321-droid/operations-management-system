# Development only. Production must supply a long random value.
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TERUISI_DJANGO_ENVIRONMENT=development
TERUISI_DJANGO_PROCESS_ROLE=development
TERUISI_DJANGO_EXPECT_READ_ONLY=false
TERUISI_DJANGO_LOG_LEVEL=INFO

# Omit to use the local SQLite database at .runtime/django/teruisi.sqlite3.
# PostgreSQL example: postgresql://user:password@127.0.0.1:5432/teruisi
TERUISI_DJANGO_DATABASE_URL=

# Shared only by the Cloudflare/Next edge adapter and this Django service.
TERUISI_DJANGO_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
TERUISI_DJANGO_SIGNATURE_MAX_AGE_SECONDS=60
TERUISI_DJANGO_SALES_CACHE_SECONDS=300
TERUISI_DJANGO_DB_CONN_MAX_AGE=60
TERUISI_DJANGO_SYNC_MAX_AGE_SECONDS=60
TERUISI_DJANGO_MAX_HEADER_BYTES=32768
TERUISI_DJANGO_MAX_BODY_BYTES=1048576

# The local production launcher sets environment=production, role=reader,
# DEBUG=false, loopback-only PostgreSQL, and real 32+ byte DPAPI-backed secrets.
