      "parameters": {
        "jsCode": "\nconst anchor = $('固定原执行计划时间').first().json;\n\nconst previousQueue = $input.first().json.helperQueue;\nconst helperQueue = previousQueue ?? {polls:0,startedAt:new Date().toISOString()};\nif(!Number.isInteger(helperQueue.polls) || helperQueue.polls < 0 || helperQueue.polls >= 72\n  || !Number.isFinite(Date.parse(helperQueue.startedAt)) || Date.now() < Date.parse(helperQueue.startedAt)\n  || Date.now() - Date.parse(helperQueue.startedAt) > 6*60*60*1000) throw new Error('coordination_wait_expired_manual_action');\nconst nextHelperQueue = {polls:helperQueue.polls+1,startedAt:helperQueue.startedAt};\nlet response;\ntry {\n  response = await this.helpers.httpRequest({method:'POST',url:'http://127.0.0.1:5791/coordination/claim',json:true,timeout:10000,returnFullResponse:true,ignoreHttpStatusErrors:true,\n    headers:{...{\"X-TERUISI-WORKFLOW-KEY\":\"jackyun\"},'X-TERUISI-N8N-EXECUTION-ID':String($execution.id),\n      'X-TERUISI-COORDINATION-ATTEMPT':String(helperQueue.polls),'X-TERUISI-SCHEDULED-AT':anchor.scheduledAt}});\n} catch (error) {\n  const status = Number(error.statusCode ?? error.response?.statusCode ?? error.httpCode ?? 0);\n  if (status >= 400 && status < 500) throw new Error('coordination_rejected_manual_action');\n  // This node has no business effect. Retry only this same claim/execution;\n  // never call A or replay any export/import/send on an uncertain response.\n  return [{json:{ok:true,coordinationStatus:'waiting',helperQueue:nextHelperQueue,reason:'helper_unavailable_wait',...anchor}}];\n}\nconst status = Number(response.statusCode);\nif (status >= 400 && status < 500) throw new Error('coordination_rejected_manual_action');\nif (status >= 500) return [{json:{ok:true,coordinationStatus:'waiting',helperQueue:nextHelperQueue,reason:'helper_unavailable_wait',...anchor}}];\nif (status !== 200) throw new Error('invalid_coordination_http_status_manual_action');\nconst result = response.body;\nif (!result || result.ok !== true || !['granted','waiting'].includes(result.coordinationStatus)) throw new Error('invalid_coordination_result_manual_action');\nreturn [{json:{...result,...anchor,...(result.coordinationStatus === 'waiting' ? {helperQueue:nextHelperQueue} : {})}}];"
      },
