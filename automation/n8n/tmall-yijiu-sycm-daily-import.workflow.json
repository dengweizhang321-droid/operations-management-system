    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const output = [];\nfor (const item of items) {\n  const filePath = typeof item.json.path === 'string' ? item.json.path : '';\n  if (!/\\.xls$/i.test(filePath)) continue;\n  output.push({\n    json: {\n      ...item.json,\n      pathBase64: Buffer.from(filePath, 'utf8').toString('base64'),\n    },\n  });\n}\nreturn output;"
      },
      "id": "5fc6d4e8-82b2-4870-99fa-f2a73cb43863",
